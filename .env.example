# Elasticsearch / OpenSearch
ES_SCHEME=https
ES_HOST=192.168.100.45
ES_PORT=9200
ES_AUTH_USER=
ES_AUTH_PASSWORD=
ES_VERIFY_SSL=false
ES_INDEX_TIMEOUT=5
INDEX_CONFIG_FILE=./index_config.yaml

# LLM
LLM_BASE_URL=http://10.180.158.23:18080
LLM_MODEL=Qwen/Qwen3-32B
LLM_API_KEY=not-empty
LLM_TEMPERATURE=0
LLM_MAX_CONTEXT_TOKENS=128000
LLM_SAFETY_MARGIN=2000
LLM_MIN_OUTPUT_TOKENS=1000
LLM_MAX_OUTPUT_TOKENS=50000
LLM_MAX_REQUEST_TOKENS=2000
LLM_ENABLE_THINKING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_PING_TIMEOUT=2
REDIS_MAX_CONNECTIONS=50
SESSION_TTL=3600
CACHE_TOOL_TTL=300
INDEX_CACHE_TTL=300

# Agent service
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
APP_TIMEOUT_KEEP_ALIVE=60
CORS_ORIGINS=*

# Alert rule service
ALERT_SSO_APP_ID=
ALERT_SSO_SECRET_KEY=
ALERT_API_DOMAIN=https://192.168.101.54:8888
ALERT_REQUEST_TIMEOUT=50
ALERT_VERIFY_SSL=false

# Timeout policies
ES_QUERY_TIMEOUT=90
LLM_CALL_TIMEOUT=90
HTTP_REQUEST_TIMEOUT=45
TOOL_EXECUTION_TIMEOUT=150
TOTAL_REQUEST_TIMEOUT=240
COMPRESSION_THRESHOLD=3
COMPRESSION_MAX_TOKENS=2000
COMPRESSION_MAX_RETURN_DATA=3
IP_TRACE_COMPRESSION_THRESHOLD=15
IP_TRACE_MAX_RETURN_DATA=5
QUERY_MAX_RECORDS=100
FREE_QUERY_MAX_ATTEMPTS=3
ALERT_TABLE_NAME=alarm_result
ALERT_PAGE_SIZE=500
